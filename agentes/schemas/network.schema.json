{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "network"
    },
    "enabled": {
      "const": false
    },
    "default": {
      "const": "deny"
    },
    "allowed_hosts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "maxItems": 0
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "kind",
    "enabled",
    "default",
    "allowed_hosts",
    "notes"
  ],
  "additionalProperties": false
}

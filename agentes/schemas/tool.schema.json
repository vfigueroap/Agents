{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "tool"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "implemented",
        "planned"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "implementation": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution": {
      "type": "string",
      "enum": [
        "local",
        "external"
      ]
    },
    "inputs": {
      "type": "string",
      "minLength": 1
    },
    "outputs": {
      "type": "string",
      "minLength": 1
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "side_effects": {
      "type": "string",
      "enum": [
        "none",
        "external"
      ]
    },
    "approval": {
      "type": "string",
      "enum": [
        "not_required",
        "unavailable"
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "name",
    "status",
    "description",
    "action",
    "implementation",
    "execution",
    "inputs",
    "outputs",
    "permissions",
    "connections",
    "side_effects",
    "approval"
  ],
  "additionalProperties": false
}

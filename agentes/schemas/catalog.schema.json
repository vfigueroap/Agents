{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "catalog"
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https://github\\.com/[^/]+/[^/]+$"
          },
          "status": {
            "const": "candidate_pending_evaluation"
          },
          "adoption": {
            "const": "not_approved"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "review": {
            "type": "object",
            "properties": {
              "license": {
                "type": "null"
              },
              "provenance": {
                "type": "null"
              },
              "activity": {
                "type": "null"
              },
              "compatibility": {
                "type": "null"
              },
              "dependencies": {
                "type": "null"
              },
              "security": {
                "type": "null"
              },
              "permissions": {
                "type": "null"
              },
              "utility": {
                "type": "null"
              },
              "maintenance": {
                "type": "null"
              },
              "execution_risk": {
                "type": "null"
              },
              "pinned_revision": {
                "type": "null"
              }
            },
            "required": [
              "license",
              "provenance",
              "activity",
              "compatibility",
              "dependencies",
              "security",
              "permissions",
              "utility",
              "maintenance",
              "execution_risk",
              "pinned_revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "url",
          "status",
          "adoption",
          "purpose",
          "review"
        ],
        "additionalProperties": false
      },
      "minItems": 27,
      "maxItems": 27
    }
  },
  "required": [
    "schema_version",
    "kind",
    "repositories"
  ],
  "additionalProperties": false
}

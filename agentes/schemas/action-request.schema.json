{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "tool_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "input": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "agent_id",
    "tool_id",
    "input"
  ],
  "additionalProperties": false
}

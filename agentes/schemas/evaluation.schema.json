{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "evaluation"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "category": {
      "type": "string",
      "enum": [
        "agents",
        "skills",
        "security",
        "benchmarks"
      ]
    },
    "status": {
      "const": "scenario_defined"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "request": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "automated": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "request",
          "expected",
          "automated"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "category",
    "status",
    "cases"
  ],
  "additionalProperties": false
}

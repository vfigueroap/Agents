{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "denied",
        "needs_clarification"
      ]
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "classification": {
      "const": "synthetic"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "task_id",
    "status",
    "agent_id",
    "classification",
    "summary"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "agent"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "enum": [
        "orchestrator",
        "personal",
        "academic",
        "engineering",
        "software",
        "infrastructure",
        "finance",
        "business",
        "marketing",
        "commercial",
        "legal"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "defined",
        "proposed",
        "migration_pending"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "allowed_tasks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "instructions": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "functions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "migration_status": {
            "const": "pending"
          },
          "source_instructions": {
            "type": "null"
          }
        },
        "required": [
          "id",
          "name",
          "functions",
          "migration_status",
          "source_instructions"
        ],
        "additionalProperties": false
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "permissions": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "allow",
        "deny"
      ],
      "additionalProperties": false
    },
    "delegation": {
      "type": "object",
      "properties": {
        "policy": {
          "const": "bounded"
        },
        "allowed_agents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "max_tasks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "policy",
        "allowed_agents",
        "max_depth",
        "max_tasks"
      ],
      "additionalProperties": false
    },
    "evaluation": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "io": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "inputs",
        "outputs"
      ],
      "additionalProperties": false
    },
    "errors": {
      "type": "object",
      "properties": {
        "on_unavailable": {
          "const": "report_and_stop"
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "on_unavailable",
        "max_retries"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_policy": {
      "type": "string",
      "const": "policies/approvals.yaml"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "name",
    "domain",
    "status",
    "purpose",
    "responsibilities",
    "allowed_tasks",
    "limits",
    "instructions",
    "profiles",
    "skills",
    "tools",
    "connections",
    "permissions",
    "delegation",
    "evaluation",
    "io",
    "errors",
    "model",
    "runtime",
    "approval_policy"
  ],
  "additionalProperties": false
}

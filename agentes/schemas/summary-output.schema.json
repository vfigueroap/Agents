{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "classification": {
      "const": "synthetic"
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "total": {
      "type": "number"
    }
  },
  "required": [
    "classification",
    "count",
    "total"
  ],
  "additionalProperties": false
}
